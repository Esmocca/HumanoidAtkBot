#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define ServoMaxDegree 600
#define ServoMinDegree 150
Adafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver(0x40);

#define ScreenWidth 128
#define ScreenHeight 64
#define OledReset -1
Adafruit_SSD1306 display(ScreenWidth, ScreenHeight, &Wire1, -1);

#define SERVO_PUNGGUNG 0
#define SERVO_BAHUKANAN 1
#define SERVO_TANGANKIRI 2
#define SERVO_SIKUKANAN 3
#define SERVO_PINGGANG 4
#define SERVO_KAKIKANAN 5
#define SERVO_KAKIKIRI 6
#define SERVO_LUTUTKANAN 7
#define SERVO_LUTUTKIRI 8
#define SERVO_TELAPAKKANAN 9
#define SERVO_TELAPAKKIRI 10

struct WiFiData {
    const char* ssid = "esmooca";
    const char* password = "jangantanya";
} wifiData;

struct ServerData {
    const char* serverIP = "10.166.206.96";
    const int serverPort = 50003;
} serverData;

struct PlayerData {
    const char* ClientName = "Stellar";
    int hp = 200;
    int atk = 30;
    int deff = 30;
    int strength = 10;
    int energy = 50;
    const int energyMax = 50;
    const int energyRegen = 10;
    unsigned long lastRegen = 0;
    const unsigned long energyInterval = 8000;
    bool robotAlive = true;
    int hpstats = hp;
} player;

struct ButtonPins {
    const int SkillPin = 12;
    const int ResetPin = 13;
    const int AtkPin = 14;
    const int BlockPin = 15;
} buttonPins;

struct BlockData {
    int block_press_count = 0;
    int block_state = 0;
    int prev_block_state = 0;
    unsigned long lastBlockTime = 0, BlockTiming = 3000;
    bool isBlocking = false;
} blockData;

struct AttackData {
    int attack_state = 0;
    unsigned long lastAtkTime = 0;
    unsigned long AtkTiming = 500;
    bool isAttacking = false;
    bool atkReleased = true;
    unsigned long lastAttack = 0;
} attackData;

struct SkillData {
    int skill_state = 0;
    unsigned long lastSkillTime = 0, SkillTiming = 500;
    bool isUsingSkill = false;
    bool skillReleased = true;
    unsigned long lastSkill = 0;
} skillData;

struct AnimationVariables {
    int hitAnimationIndex = 0;
    int defeatAnimationStep = 0;
    unsigned long defeatMotionStart = 0;
    bool isHitAnimating = false;
    unsigned long hitAnimationStart = 0;
    bool blockingAtkMotionActive = false;
    unsigned long blockingAtkMotionStart = 0;
} animationVar;

int buttonState = LOW;

WiFiClient client;

void setup() {
    Serial.begin(115200);
    Wire1.setSDA(18);
    Wire1.setSCL(19);
    Wire1.begin();

    if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) { 
      Serial.println("OLED Gagal");
      while(1);
  }
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(WHITE);

    Wire.setSDA(20);
    Wire.setSCL(21);
    Wire.begin();
    pwm.begin();
    pwm.setPWMFreq(50); 

    pinMode(buttonPins.AtkPin, INPUT_PULLUP);
    pinMode(buttonPins.BlockPin, INPUT_PULLUP);
    pinMode(buttonPins.ResetPin, INPUT_PULLUP);
    pinMode(buttonPins.SkillPin, INPUT_PULLUP);

    setIdlePosition();
    connectToWiFi();
    connectToServer();
}

void ServoAngle(uint8_t servo, int angle) {
    int pulse = map(angle, 0, 180, ServoMinDegree, ServoMaxDegree);
    pwm.setPWM(servo, 0, pulse);
}

void UpdateDisplay(const PlayerData& player) {
    display.clearDisplay();
    display.setTextColor(WHITE);
    display.setTextSize(1);
    display.setCursor(10, 0);
    display.println(player.ClientName);
    display.println("HP: " + String(player.hp));
    display.println("ATK: " + String(player.atk));
    display.println("DEF: " + String(player.deff) + "%");
    display.println("STR: " + String(player.strength) + "%");
    display.println("ENG: " + String(player.energy));
    display.display();
}

void displayprint(const String& text) {
    display.setTextColor(WHITE);
    display.setTextSize(1);
    display.println(text);
    display.clearDisplay();
    display.setCursor(0,0);
    display.println(text);
    display.display();
}

void connectToWiFi() {
    Serial.println("Connecting to WiFi...");
    displayprint("Connecting to WiFi...");
    WiFi.begin(wifiData.ssid, wifiData.password);

    while (WiFi.status() != WL_CONNECTED) {
        delay(500);
        Serial.print(".");
    }
    displayprint("Connected to WiFi!\nIP: " + WiFi.localIP().toString());
    delay(2000);
}

void connectToServer() {
    displayprint("Connecting to server...");
    while (!client.connect(serverData.serverIP, serverData.serverPort)) {
        Serial.println("Connection failed, retrying...");
        delay(5000);
    }
    client.println(player.ClientName);
    displayprint("Connected to server!");
}

void handleServer(){
    if (!client.connected()) connectToServer();
    while (client.available()) {
        String data = client.readStringUntil('\n');
        data.trim();
        Serial.println("Received: " + data);

        if (data.startsWith("Atk")) {
            int Damage = data.substring(4).toInt();
            handleDamage(Damage);
        } else if (data.startsWith("Buff")) {
            handleBuff(data);
        }
    }
}

void setIdlePosition() {
  ServoAngle(SERVO_BAHUKANAN, 50);//-kanan +kiri
  ServoAngle(SERVO_TANGANKIRI, 15);// - semakin kecil semakin kedepan
  ServoAngle(SERVO_PUNGGUNG, 140);//-semakin kecil semakin naik
  ServoAngle(SERVO_SIKUKANAN, 60);//- semakin kecil semakin kebelakang
  ServoAngle(SERVO_PINGGANG, 20);//-semakin besar semakin ke kiri

  ServoAngle(SERVO_KAKIKANAN, 30);// -semakin besar semakin kebelakang (kaki kiri)
  ServoAngle(SERVO_KAKIKIRI, 80);// -semakin besar semakin kedepan (kaki kanan)
  ServoAngle(SERVO_LUTUTKANAN , 20);// -semakin kecil semakin lurus
  ServoAngle(SERVO_LUTUTKIRI , 80);// -semakin besar semakin lurus
  ServoAngle(SERVO_TELAPAKKANAN , 90);// -semakin besar semakin maju
  ServoAngle(SERVO_TELAPAKKIRI , 80);// -semakin kecil semakin maju
}

bool debounceButton(int pin) {
    static unsigned long lastPressTime = 0;
    static int lastButtonState = LOW;
    int currentState = digitalRead(pin);

    if (currentState != lastButtonState) {
        lastPressTime = millis();
    }

    if ((millis() - lastPressTime) > 50) {
        if (currentState != buttonState) {
            buttonState = currentState;
        }
    }
    lastButtonState = currentState;
    return buttonState == HIGH;
}

void handleEnergy() {
    if (millis() - player.lastRegen >= player.energyInterval) {
        player.energy = min(player.energy + player.energyRegen, player.energyMax);
        player.lastRegen = millis();
    }
}

void handleBuff(const String& command) {
  int buffType = -1;
  if (command.indexOf("HP") > 0) buffType = 0;
  else if (command.indexOf("ATK") > 0) buffType = 1;
  else if (command.indexOf("DEF") > 0) buffType = 2;
  else if (command.indexOf("STR") > 0) buffType = 3;
  else if (command.indexOf("ENGY") > 0) buffType = 4;

  switch (buffType) {
    case 0:
      player.hp = player.hp + player.hp / 10;
      player.hpstats = player.hp;
      Serial.println("HP Buffed +10%");
      displayprint("HP Buff +10%");
      break;
    case 1:
      player.atk = player.atk + player.atk / 10;
      Serial.println("ATK Buffed +10%");
      displayprint("ATK Buff +10%");
      break;
    case 2:
      player.deff = player.deff + player.deff / 10;
      Serial.println("DEF Buffed +10%");
      displayprint("DEF Buff +10%");
      break;
    case 3:
      player.strength = player.strength + player.strength / 10;
      Serial.println("STR Buffed +10%");
      displayprint("STR Buff +10%");
      break;
    case 4:
      player.energy = player.energy + player.energy / 10;
      player.energy = min(player.energy, player.energyMax);
      Serial.println("Energy Buffed +10%");
      displayprint("ENGY Buff +10%");
      break;
    default:
      Serial.println("Unknown buff command");
      break;
  }
}

void handleDamage(int damage) {
    if (!player.robotAlive) return;

    if (blockData.isBlocking && player.energy > 0){
        Serial.println("Attack Blocked!");
        player.energy = max(player.energy - 5,0);
        handleBlockAtkmotion();
        return;
    } else {
        blockData.isBlocking = false;
    }

    int TotalDamage = damage - (damage * player.deff / 100);

    player.hp = max(player.hp - TotalDamage, 0);
    if (player.hp <= 0) {
        handleDefeat();
    } else {
        animationVar.hitAnimationIndex = (animationVar.hitAnimationIndex + 1) % 3;
        animationVar.isHitAnimating = true;
        animationVar.hitAnimationStart = millis();
    }
}

void handleHitMotion() {
    if(!animationVar.isHitAnimating) return;

    unsigned long currentTime = millis();
    switch(animationVar.hitAnimationIndex) {
      case 0:
      if(currentTime - animationVar.hitAnimationStart > 200) {
      ServoAngle(SERVO_PINGGANG, 0);
      ServoAngle(SERVO_TANGANKIRI, 110);
      Serial.println("Hit motion 1");
      delay(50);
      }
      if(currentTime - animationVar.hitAnimationStart > 300) {
        setIdlePosition();
        animationVar.isHitAnimating = false;
      }
      break;

      case 1:
      if(currentTime - animationVar.hitAnimationStart > 200) {
      ServoAngle(SERVO_PINGGANG, 40);
      ServoAngle(SERVO_TANGANKIRI, 110);
      Serial.println("Hit motion 2");
      delay(50);
      }
      if(currentTime - animationVar.hitAnimationStart > 300) {
        setIdlePosition();
        animationVar.isHitAnimating = false;
      }
      break;

      case 2:
      if(currentTime - animationVar.hitAnimationStart > 200) {
      ServoAngle(SERVO_PINGGANG, 0);
      ServoAngle(SERVO_BAHUKANAN, 30);
      ServoAngle(SERVO_SIKUKANAN, 90);
      Serial.println("Hit motion 3");
      delay(50);
      }
      if(currentTime - animationVar.hitAnimationStart > 300) {
        setIdlePosition();
        animationVar.isHitAnimating = false;
      }
      break;
    }
  }

void handleBlockAtkmotion() {

  if(!animationVar.blockingAtkMotionActive){
  animationVar.blockingAtkMotionActive = true;
  animationVar.blockingAtkMotionStart = millis();
  }
  unsigned long currentTime = millis();
    if (currentTime - animationVar.blockingAtkMotionStart > 200){
      ServoAngle(SERVO_TANGANKIRI, 0); 
      ServoAngle(SERVO_PINGGANG, 0);
      Serial.println("BlockingAtkMotion");
      delay(50);
    } 
    if (currentTime - animationVar.blockingAtkMotionStart > 400){
      setIdlePosition();
      animationVar.blockingAtkMotionActive = false;
    }
}

void handleDefeat() {
  player.robotAlive = false;
  client.print(String(player.ClientName) + " defeated!\n");
  animationVar.defeatAnimationStep = 0;
  animationVar.defeatMotionStart = millis();
  displayprint("DEFEATED! Hold reset");
  displayprint("5s to reboot");
  //client.stop();
}

void handleDefeatMotion() {
  switch(animationVar.defeatAnimationStep) {
    case 0:
      ServoAngle(SERVO_PINGGANG, 5);
      ServoAngle(SERVO_TANGANKIRI, 90);
      ServoAngle(SERVO_BAHUKANAN, 40);
      ServoAngle(SERVO_SIKUKANAN, 100);
      if(millis() - animationVar.defeatMotionStart > 1000) {
        animationVar.defeatAnimationStep = 1;
        animationVar.defeatMotionStart = millis();
      }
      break;
  }
}

void checkReset() {
  static unsigned long resetStart = 0;

  if (digitalRead(buttonPins.ResetPin) == LOW) {
    if (resetStart == 0) {
      resetStart = millis();
    } 
    else if (millis() - resetStart > 5000) {
  
      player.hp = player.hpstats;
      player.energy = player.energyMax;
      player.robotAlive = true;
      animationVar.defeatAnimationStep = 0;
      attackData.isAttacking = false;
      blockData.isBlocking = false;
      animationVar.isHitAnimating = false;
      animationVar.blockingAtkMotionActive = false;
      setIdlePosition();
      
      if (!client.connected()) {
        connectToServer();
      }

      displayprint("Reboot Complete!");
      Serial.println("System Reset!");
      delay(1500);
      resetStart = 0;
    }
  } 
  else {
    resetStart = 0; 
  }
}

void sendAttack() {

  int totalAtk = player.atk + (player.atk * player.strength / 100);
  String msg = "Atk " + String(totalAtk) + "\n";
  client.print(msg);
  Serial.println("Attack Sent: " + msg);
}

void BlockState()
{
  static unsigned long lastEnergyDrain = 0;
  blockData.block_state = digitalRead(buttonPins.BlockPin);
  
  if (blockData.block_state ==  LOW && !blockData.isBlocking && player.energy > 0) {
    blockData.isBlocking = true;
    player.energy = max(player.energy - 1, 0);
    blockData.lastBlockTime = millis();
    Serial.println("Blocking...");
  }

  if (blockData.isBlocking && player.energy > 0) {
    if (millis() - lastEnergyDrain > 1000) {
      lastEnergyDrain = millis();
    }
    unsigned long currentTime = millis();
    blockData.isBlocking = true;
    if (currentTime - blockData.lastBlockTime < 400) {
      ServoAngle(SERVO_TANGANKIRI,5);
      ServoAngle(SERVO_PINGGANG, 5);
      ServoAngle(SERVO_BAHUKANAN, 130);//-kanan +kiri
      ServoAngle(SERVO_SIKUKANAN, 130);//- semakin kecil semakin kebelakang
      delay(50);
    } else {
      blockData.isBlocking = false;
    }
  }
}

void setIdleAnimation() 
{
  static unsigned long idleStartTime = 0;

  if (digitalRead(buttonPins.AtkPin) == LOW || digitalRead(buttonPins.BlockPin) == LOW 
      || attackData.isAttacking || animationVar.isHitAnimating || animationVar.blockingAtkMotionActive) {
    idleStartTime = 0;
    return;
  }

  if (idleStartTime == 0) {
    idleStartTime = millis();
  }

  if (millis() - idleStartTime >= 500) {
    float t = millis() / 1000.0;

    float amplitude = 5.0;
    float speed = 1.5;

    float offset = amplitude * sin(speed * t);
      // Terapkan pergeseran offset ke beberapa servo
       ServoAngle(SERVO_BAHUKANAN, 50 + offset);   // Contoh: Bahu kanan
       ServoAngle(SERVO_PUNGGUNG, 140 + amplitude * sin(speed * t + 0.5));      // Punggung
       ServoAngle(SERVO_SIKUKANAN, 60 + amplitude * sin(speed * t + 0.5));      // Siku kanan
       ServoAngle(SERVO_PINGGANG, 20 + amplitude * sin(speed * t + 0.5));       // Pinggang
       ServoAngle(SERVO_KAKIKANAN, 30 + amplitude * sin(speed * t + 0.5));// -semakin besar semakin kebelakang (kaki kiri)
       ServoAngle(SERVO_KAKIKIRI, 80 +amplitude * sin(speed * t + 0.5));
  }
}

void handleAtkState() {

  if (blockData.isBlocking) {
    Serial.println("Cannot attack while blocking.");
    return;
  }
  
  static int animationIndex = 0;
  attackData.attack_state = debounceButton(buttonPins.AtkPin);

  if (attackData.attack_state == LOW && !attackData.isAttacking) {
    if (!blockData.isBlocking && digitalRead(buttonPins.AtkPin) == LOW && attackData.atkReleased) {
      attackData.isAttacking = true;
      if (millis() - attackData.lastAttack > 1000 && player.energy >= 10) {
      sendAttack();
      player.energy = max(player.energy - 5, 0);
      attackData.lastAtkTime = millis();
      Serial.println("Attack started.");
      attackData.atkReleased = false;
      }
    }
  }
  if (attackData.isAttacking) {
    unsigned long currentTime = millis();
    switch (animationIndex) {
      case 0:  // Animasi serangan 1
        if (currentTime - attackData.lastAtkTime < 200) {
          ServoAngle(SERVO_PINGGANG, 120);
          ServoAngle(SERVO_PUNGGUNG, 80);
          ServoAngle(SERVO_BAHUKANAN, 140);

        } else if (currentTime - attackData.lastAtkTime < 500) {
          ServoAngle(SERVO_PINGGANG, 20);
          ServoAngle(SERVO_BAHUKANAN, 40);
        } else {
          attackData.isAttacking = false;
          animationIndex = (animationIndex + 1) % 3;  // Pindah ke animasi berikutnya
          setIdlePosition();
          Serial.println("Attack 1 ended.");
          delay(50);
          attackData.atkReleased = true;
        }
        break;

      case 1:  // Animasi serangan 2
        if (currentTime - attackData.lastAtkTime < 200) {
          ServoAngle(SERVO_PINGGANG, 20);
          ServoAngle(SERVO_BAHUKANAN, 50);
        } else if (currentTime - attackData.lastAtkTime < 500) {
          ServoAngle(SERVO_PUNGGUNG, 90);
          ServoAngle(SERVO_PINGGANG, 120);
          ServoAngle(SERVO_BAHUKANAN, 140);
        }
         else {
          attackData.isAttacking = false;
          animationIndex = (animationIndex + 1) % 3;  // Pindah ke animasi berikutnya
          setIdlePosition();
          Serial.println("Attack 2 ended.");
          delay(50);
          attackData.atkReleased = true;
        }
        break;

      case 2:  // Animasi serangan 3 -+
        if (currentTime - attackData.lastAtkTime < 200) {
         ServoAngle(SERVO_PINGGANG, 10);
         ServoAngle(SERVO_SIKUKANAN, 80);;//-kanan +kiri

        } else if (currentTime - attackData.lastAtkTime < 400) {
          ServoAngle(SERVO_PINGGANG, 140);
          ServoAngle(SERVO_PUNGGUNG, 80);
          ServoAngle(SERVO_BAHUKANAN, 40);
        }
          else {
          attackData.isAttacking = false;
          animationIndex = (animationIndex + 1) % 3;  // Pindah ke animasi berikutnya
          setIdlePosition();
          Serial.println("Attack 3 ended.");
          delay(50);
          attackData.atkReleased = true;
        }
        break;
    }
  }
  else {
    // Servo dalam posisi idle saat tidak menyerang
    setIdlePosition();
    setIdleAnimation();
  }
}

void loop() {
  checkReset();

  if (!player.robotAlive) {
    handleDefeatMotion();
    checkReset();
    handleServer();
    UpdateDisplay(player);
    //checkReset();
    return;
  }
  handleEnergy();

  if (animationVar.isHitAnimating) {
    handleHitMotion();
  }

  handleServer();
  UpdateDisplay(player);
  handleAtkState();
  BlockState();
}
